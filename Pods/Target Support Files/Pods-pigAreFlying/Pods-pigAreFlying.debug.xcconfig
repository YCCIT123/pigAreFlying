ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/LookinServer" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "${PODS_CONFIGURATION_BUILD_DIR}/YGDCoreKit" "${PODS_CONFIGURATION_BUILD_DIR}/YGDFocusModule" "${PODS_CONFIGURATION_BUILD_DIR}/YGDInsightsModule" "${PODS_CONFIGURATION_BUILD_DIR}/YGDModuleBridgeKit" "${PODS_CONFIGURATION_BUILD_DIR}/YGDModuleIndexKit" "${PODS_CONFIGURATION_BUILD_DIR}/YGDRouterKit" "${PODS_CONFIGURATION_BUILD_DIR}/YGDSettingsModule" "${PODS_CONFIGURATION_BUILD_DIR}/YGDTasksModule" "${PODS_CONFIGURATION_BUILD_DIR}/YGDTodayModule" "${PODS_CONFIGURATION_BUILD_DIR}/YGDUIKitKit" "${PODS_CONFIGURATION_BUILD_DIR}/lottie-ios"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/LookinServer/LookinServer.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDCoreKit/YGDCoreKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDFocusModule/YGDFocusModule.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDInsightsModule/YGDInsightsModule.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDModuleBridgeKit/YGDModuleBridgeKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDModuleIndexKit/YGDModuleIndexKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDRouterKit/YGDRouterKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDSettingsModule/YGDSettingsModule.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDTasksModule/YGDTasksModule.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDTodayModule/YGDTodayModule.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YGDUIKitKit/YGDUIKitKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/lottie-ios/Lottie.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift $(SDKROOT)/usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"swiftCoreGraphics" -framework "Alamofire" -framework "CFNetwork" -framework "CoreGraphics" -framework "LookinServer" -framework "Lottie" -framework "QuartzCore" -framework "SnapKit" -framework "UIKit" -framework "YGDCoreKit" -framework "YGDFocusModule" -framework "YGDInsightsModule" -framework "YGDModuleBridgeKit" -framework "YGDModuleIndexKit" -framework "YGDRouterKit" -framework "YGDSettingsModule" -framework "YGDTasksModule" -framework "YGDTodayModule" -framework "YGDUIKitKit" -weak_framework "Combine" -weak_framework "SwiftUI"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "-F${PODS_CONFIGURATION_BUILD_DIR}/LookinServer" "-F${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDCoreKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDFocusModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDInsightsModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDModuleBridgeKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDModuleIndexKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDRouterKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDSettingsModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDTasksModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDTodayModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/YGDUIKitKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/lottie-ios"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
